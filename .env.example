# QuadAgile - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ============================================
# HOSTINGER DEPLOYMENT CREDENTIALS (Required)
# ============================================

# FTP Credentials (for frontend deployment)
HOSTINGER_FTP_SERVER=ftp.quadagile.in
HOSTINGER_FTP_USERNAME=your-ftp-username
HOSTINGER_FTP_PASSWORD=your-ftp-password

# SSH Credentials (optional - for backend deployment)
HOSTINGER_SSH_HOST=your-server-ip-or-hostname
HOSTINGER_SSH_USERNAME=your-ssh-username
HOSTINGER_SSH_PASSWORD=your-ssh-password

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# API URL (your backend URL)
VITE_API_URL=https://api.quadagile.in

# Google reCAPTCHA v3 Site Key
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Google Analytics 4 Tracking ID
# Get from: https://analytics.google.com
VITE_GA4_ID=G-XXXXXXXXXX

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret (generate a strong random string)
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Google reCAPTCHA v3 Secret Key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Database Path
DB_PATH=./data/quadagile.db

# CORS Allowed Origins
CORS_ORIGINS=https://quadagile.in,https://www.quadagile.in

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@quadagile.in
ADMIN_PASSWORD=your-secure-admin-password

# Contact Form Email
CONTACT_EMAIL=reach-us@quadagile.in

# Google Analytics 4 API (for server-side tracking)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
