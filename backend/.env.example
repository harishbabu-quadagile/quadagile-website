# QuadAgile CMS Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# reCAPTCHA v3 Configuration
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Database
DB_PATH=./data/quadagile.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://quadagile.in,https://www.quadagile.in

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@quadagile.in
ADMIN_PASSWORD=change-this-password

# Contact Form
CONTACT_EMAIL=reach-us@quadagile.in

# GA4 Tracking ID (for server-side events)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your-ga4-api-secret
